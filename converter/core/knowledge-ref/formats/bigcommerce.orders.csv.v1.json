  "provenance": "native-platform",
  "medium": "csv",
  "platformHint": "bigcommerce",
  "entity": "orders",
  "signatures": [
    {
      "kind": "csv-header-set",
      "required": [
        "Order ID",
        "Order Total (inc tax)"
      ],
      "hints": [
        "Subtotal (inc tax)",
        "Order Status",
        "Customer Email"
      ]
    }
