      "transform": "text",
      "confidence": "verified-fixture"
    },
    {
      "path": "Order Status",
      "canon": "financialStatus+fulfillmentStatus",
      "transform": "enum_map",
      "confidence": "verified-fixture",
      "notes": "refund / cancel / pending / … and ship / complete / deliver → the two target statuses."
    },
    {
      "path": "Order Currency Code",
