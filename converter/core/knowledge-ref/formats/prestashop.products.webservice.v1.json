{
  "schemaVersion": 1,
  "id": "prestashop.products.webservice.v1",
  "displayName": "PrestaShop Products (Webservice, 9.0.x)",
  "provenance": "native-platform",
  "medium": "json-api",
  "platformHint": "prestashop",
  "entity": "products",
  "version": "ps-9.0.x",
  "signatures": [
    {
      "kind": "json-shape",
      "requiredPaths": [
        "id",
        "reference",
        "id_manufacturer",
        "id_category_default",
        "associations"
      ],
      "hintPaths": [
        "id_default_combination",
        "link_rewrite",
        "associations.combinations",
        "associations.product_features",
        "product_type",
        "id_tax_rules_group",
        "meta_title",
        "wholesale_price"
      ]
    }
  ],
  "structure": {
    "unit": "product",
    "variants": {
      "companion": "variations",
      "keyedBy": "id",
      "childParentPath": "id_product",
      "selfWhenNone": true,
      "sameEntity": false
    },
    "companions": {
      "variations": {
        "route": "GET /api/combinations?display=full&filter[id_product]=<id>",
        "keyedByParent": false,
        "note": "PrestaShop resource: combinations (aka product attributes). Flat array; children reference the parent via id_product; per-combination reference/ean13/upc/mpn/isbn plus price/weight DELTAS (unit_price_impact) — the effective price is parent + delta"
      },
      "stock": {
        "route": "GET /api/stock_availables?display=full",
        "keyedByParent": false,
        "note": "one row per (id_product, id_product_attribute, id_shop). Product-level row uses id_product_attribute = 0; combination stock uses id_product_attribute = <combination id>"
      },
      "specificPrices": {
        "route": "GET /api/specific_prices?display=full",
        "keyedByParent": false,
        "note": "per-product / per-combination discounts + quantity tiers (from_quantity + reduction/reduction_type)"
      },
      "productFeatures": {
        "route": "GET /api/product_features?display=full",
        "keyedByParent": false,
        "note": "descriptive attributes (Composition, Property, …) — multilingual name"
      },
      "productFeatureValues": {
        "route": "GET /api/product_feature_values?display=full",
        "keyedByParent": false,
        "note": "the assignable values of each feature (Polyester, Wool, Ceramic, …) — multilingual value"
      },
      "productOptions": {
        "route": "GET /api/product_options?display=full",
        "keyedByParent": false,
        "note": "variation axes (Size, Color, Dimension, Paper Type) — multilingual name + is_color_group"
      },
      "productOptionValues": {
        "route": "GET /api/product_option_values?display=full",
        "keyedByParent": false,
        "note": "the option values referenced by combinations.associations.product_option_values[].id; carries id_attribute_group linking back to product_options"
      },
      "categories": {
        "route": "GET /api/categories?display=full",
        "keyedByParent": false,
        "note": "hierarchy (id_parent, level_depth); multilingual name/link_rewrite"
      },
      "manufacturers": {
        "route": "GET /api/manufacturers?display=full",
        "keyedByParent": false,
        "note": "id → name; brand as a first-class entity"
      },
      "languages": {
        "route": "GET /api/languages?display=full",
        "keyedByParent": false,
        "note": "the shop's languages; id ↔ locale (BCP-47, e.g. en-US) ↔ iso_code"
      }
    }
  },
  "invariantsExpected": [
    "every multilingual field is [{ id, value }] — id is the language id (join through the languages companion), value is a string (may be '')",
    "combinations are stored as a separate resource, not nested in the product; each combination has id_product = parent id",
    "combination.price is a DELTA on top of the parent price (unit_price_impact); combination.weight is a DELTA too",
    "stock lives in stock_availables keyed by (id_product, id_product_attribute); product-level row uses id_product_attribute = 0",
    "id_manufacturer = 0 means 'no brand' (not a real id) — never resolved into a name",
    "product_type ∈ { standard, combinations, virtual, pack } — a pack carries its composition under associations.product_bundle[] (id, id_product_attribute, quantity)",
    "PrestaShop weight unit is kg (shop-configurable but 'kg' by default and unchanged on the demo instance)",
    "associations.product_features[].{id, id_feature_value} pair a feature (name) with one of its declared values — resolved via two companions",
    "the SEO-friendly URL slug is link_rewrite (multilingual) — the canonical URL is built from category + slug"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
      "op": "seed",
      "from": "live:prestashop-test:2026-09-21",
      "origin": "reference",
      "diff": [
        "Products connector — full field map from the local instance (PS 9.0.3, demo catalogue + seeded identifiers + one quantity tier); models the Shopware entry (variants companion, inheritance-safe parent fields, multilingual joins)"
      ]
    }
  ],
