{
  "schemaVersion": 1,
  "id": "woocommerce.orders.rest.v1",
  "displayName": "WooCommerce Orders (REST API v3)",
  "provenance": "native-platform",
  "medium": "json-api",
  "platformHint": "woocommerce",
  "entity": "orders",
  "version": "wc-9.x",
  "signatures": [
    {
      "kind": "json-shape",
      "requiredPaths": [
        "id",
        "number",
        "status",
        "line_items",
        "billing",
        "prices_include_tax"
      ],
      "hintPaths": [
        "order_key",
        "created_via",
        "date_paid_gmt",
        "shipping_lines"
      ]
    }
  ],
  "structure": {
    "unit": "order",
    "items": {
      "inlinePath": "line_items",
      "keyedBy": "id"
    }
  },
  "invariantsExpected": [
    "number is the display number (= id unless a sequential-numbers plugin runs); the target never receives it as its own ID",
    "prices_include_tax is the order-level tax flag; *_gmt dates are UTC, the plain ones are site-local",
    "customer_id 0 = guest checkout; the billing e-mail is the customer reference",
    "line_items[].subtotal is before line discounts, total after; taxes[] per line"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
      "op": "seed",
      "from": "live:woocommerce-test:2026-09-21",
      "origin": "reference",
      "diff": [
        "Phase 7.6: full field map from the live REST payload (WC 11.1); numbering (7.4), payments as aggregates (7.2), statuses typed"
      ]
    }
  ],
