      "consumes": [
        "shipping_company",
        "shipping_address_2",
        "shipping_city",
        "shipping_state",
        "shipping_postcode",
        "shipping_country"
      ],
      "confidence": "verified-fixture",
      "notes": "The shipping address, or none when the user left it empty."
