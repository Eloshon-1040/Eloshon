{
  "schemaVersion": 1,
  "id": "prestashop.orders.webservice.v1",
  "displayName": "PrestaShop Orders (Webservice, 9.x)",
  "provenance": "native-platform",
  "medium": "json-api",
  "platformHint": "prestashop",
  "entity": "orders",
  "version": "ps-9.x",
  "signatures": [
    {
      "kind": "json-shape",
      "requiredPaths": [
        "id",
        "reference",
        "id_customer",
        "current_state",
        "invoice_number",
        "total_paid_tax_incl"
      ],
      "hintPaths": [
        "id_address_delivery",
        "module",
        "valid",
        "conversion_rate",
        "associations"
      ]
    }
  ],
  "structure": {
    "unit": "order",
    "items": {
      "companion": "order_details",
      "keyedBy": "id",
      "childParentPath": "id_order"
    },
    "companions": {
      "order_details": {
        "route": "GET /api/order_details?display=full",
        "keyedByParent": false,
        "note": "one row per line; flat, id_order"
      },
      "order_invoices": {
        "route": "GET /api/order_invoices?display=full",
        "keyedByParent": false,
        "note": "one row per invoice (number = the legal sequence, also mirrored on orders.invoice_number)"
      },
      "order_payments": {
        "route": "GET /api/order_payments?display=full",
        "keyedByParent": false,
        "note": "keyed by order_reference (NOT id_order); card_* fields are stripped at capture (7.7), card_brand kept"
      },
      "order_histories": {
        "route": "GET /api/order_histories?display=full",
        "keyedByParent": false,
        "note": "state changes (id_order_state, date_add)"
      },
      "order_states": {
        "route": "GET /api/order_states?display=full",
        "keyedByParent": false,
        "note": "state flags: paid, shipped, invoice, delivery, logable; name multilingual"
      },
      "order_carriers": {
        "route": "GET /api/order_carriers?display=full",
        "keyedByParent": false,
        "note": "shipping cost + tracking per order"
      },
      "order_slips": {
        "route": "GET /api/order_slip?display=full",
        "keyedByParent": false,
        "note": "credit slips = refunds (amount, shipping_cost_amount, partial, date_add) keyed by id_order — 0 rows on the local instance"
      },
      "addresses": {
        "route": "GET /api/addresses?display=full",
        "keyedByParent": false
      },
      "customers": {
        "route": "GET /api/customers?display=full",
        "keyedByParent": false
      },
      "countries": {
        "route": "GET /api/countries?display=full",
        "keyedByParent": false,
        "note": "id → iso_code"
      },
      "states": {
        "route": "GET /api/states?display=full",
        "keyedByParent": false
      },
      "currencies": {
        "route": "GET /api/currencies?display=full",
        "keyedByParent": false
      },
      "languages": {
        "route": "GET /api/languages?display=full",
        "keyedByParent": false
      }
    }
  },
  "invariantsExpected": [
    "reference (9 letters) is the customer-facing number; id is the technical sequence — neither becomes the target number (7.4)",
    "invoice_number is the LEGAL sequence: 0 until a state with invoice=1 is reached, then assigned in state-change order (observed: orders 2 then 4 → invoices 1, 2; prefix #IN from PS_INVOICE_PREFIX, displayed zero-padded); delivery_number likewise (#DE)",
    "valid = 1 once a logable state is reached; total_paid_real is what was actually paid; every amount exists tax-incl and tax-excl",
    "the state is a foreign key (current_state → order_states.*): paid / shipped / delivery flags typed the statuses",
    "order_payments rows are keyed by order_reference and exist only once paid",
    "addresses / customers / countries / states are separate resources: a numeric id on the order resolves through the companions",
    "dates are shop-local without zone (kept verbatim)"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
      "op": "seed",
      "from": "live:prestashop-test:2026-09-21",
      "origin": "reference",
      "diff": [
        "Phase 7.6: full field map from the local instance (PS 9.0.3) after two orders were paid through the back office: invoice numbering observed in motion (7.4); companions-based joins declared as data"
      ]
    }
  ],
