  "structure": {
    "unit": "order",
    "items": {
      "inlinePath": "lineItems",
      "keyedBy": "id"
    },
    "companions": {
      "_transactions": {
        "route": "GET /ecom/v1/payments/orders/{id} (Order Transactions API; inlined as _transactions = { orderId, payments[], refunds[] })",
        "keyedByParent": false
      }
    }
  },
  "invariantsExpected": [
    "number is the display number (10001…); the target never receives it as its own sequence (7.4)",
    "every amount is { amount, formattedAmount } — amount is a decimal string; taxIncludedInPrices is the order-level flag",
    "paymentStatus / fulfillmentStatus / status are three separate enums; balanceSummary carries paid / refunded / balance",
    "buyerInfo and billingInfo are absent on a back-office order; shippingInfo.logistics carries the delivery destination when there is one",
    "demo orders exist (demo: true) — treated as test orders",
    "the Order Transactions record is one object per order: payments[] (manual payments carry no regularPaymentDetails) and refunds[]"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
