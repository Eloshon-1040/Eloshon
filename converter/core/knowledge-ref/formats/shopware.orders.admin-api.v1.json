  "structure": {
    "unit": "order",
    "items": {
      "inlinePath": "lineItems",
      "keyedBy": "id"
    },
    "companions": {
      "documents": {
        "route": "POST /api/search/document associations documentType (or the documents association on the order)",
        "keyedByParent": false,
        "note": "invoice / delivery_note / credit_note; documentNumber comes from the document_* number ranges"
      },
      "numberRanges": {
        "route": "POST /api/search/number-range associations type, state",
        "keyedByParent": false,
        "note": "pattern / start per type (order, document_invoice…) — numbering.format for the report, never to generate"
      }
    }
  },
  "invariantsExpected": [
    "orderNumber comes from the `order` number range (observed: start 10000 → 10000, 10001) — the target never receives it as its own sequence",
    "invoice numbers come from the `document_invoice` number range (observed: 1000, 1001), assigned when the document is created, not when the order is placed",
    "taxStatus gross = prices tax-included; price.calculatedTaxes carries the per-rate breakdown",
    "transactions[] (payment state machine) and deliveries[] (delivery state machine) carry the typed statuses; the order state machine is the lifecycle",
    "orderCustomer is a SNAPSHOT of the customer at order time (customerId links the live one)",
    "lineItems[].payload is the product snapshot (productNumber, options…); type product | promotion | credit | custom",
    "refunds live under transactions[].captures[].refunds[] (needs a payment handler that supports refunds — none on the local instance)"
  ],
