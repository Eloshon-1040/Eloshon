  "structure": {
    "unit": "customer",
    "companions": {
      "newsletterRecipients": {
        "route": "POST /api/search/newsletter-recipient",
        "keyedByParent": false,
        "note": "the newsletter opt-in lives OUTSIDE the customer (keyed by e-mail): status direct | optIn | optOut | notSet, confirmedAt"
      }
    }
  },
  "invariantsExpected": [
    "Marketing consent is NOT on the customer: newsletter_recipient (by e-mail) carries status + confirmedAt; doubleOptIn* on the customer is the ACCOUNT registration opt-in",
    "customerNumber comes from the `customer` number range; guest = true for guest checkouts; the password hash is stripped at capture (7.7)",
    "defaultBillingAddress / defaultShippingAddress / addresses[] — country.iso only when the country association is loaded"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
      "op": "seed",
      "from": "live:shopware-test:2026-09-21",
