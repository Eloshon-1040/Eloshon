    },
    {
      "path": "price",
      "canon": "variants[].price",
      "transform": "price_pick",
      "args": {
        "field": "gross"
      },
      "confidence": "verified-live",
      "notes": "Gross (customer pays) of the first currency; net kept in sourceExtension. Inherited from the parent when the variant has no own price."
    },
    {
      "path": "price",
