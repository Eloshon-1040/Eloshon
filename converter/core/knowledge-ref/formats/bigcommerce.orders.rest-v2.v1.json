{
  "schemaVersion": 1,
  "id": "bigcommerce.orders.rest-v2.v1",
  "displayName": "BigCommerce Orders (REST v2 + sub-resources)",
  "provenance": "native-platform",
  "medium": "json-api",
  "platformHint": "bigcommerce",
  "entity": "orders",
  "version": "bc-v2",
  "signatures": [
    {
      "kind": "json-shape",
      "requiredPaths": [
        "id",
        "status_id",
        "payment_status",
        "total_inc_tax",
        "billing_address",
        "is_tax_inclusive_pricing"
      ],
      "hintPaths": [
        "_products",
        "_transactions",
        "_shipping_addresses",
        "order_source",
        "staff_notes"
      ]
    }
  ],
  "structure": {
    "unit": "order",
    "items": {
      "inlinePath": "_products",
      "keyedBy": "id"
    },
    "companions": {
      "_products": {
        "route": "GET /v2/orders/{id}/products (inlined as _products at capture)",
        "keyedByParent": false
      },
      "_shipping_addresses": {
        "route": "GET /v2/orders/{id}/shipping_addresses (inlined)",
        "keyedByParent": false
      },
      "_coupons": {
        "route": "GET /v2/orders/{id}/coupons (inlined)",
        "keyedByParent": false
      },
      "_transactions": {
        "route": "GET /v3/orders/{id}/transactions (inlined; credit_card reduced to card_type, cvv_result / payment_instrument_token stripped at capture)",
        "keyedByParent": false
      },
      "_refunds": {
        "route": "GET /v3/orders/{id}/payment_actions/refunds (inlined as _refunds)",
        "keyedByParent": false
      }
    }
  },
  "invariantsExpected": [
    "id IS the order number (no separate display number); the target never receives it as its own sequence (7.4)",
    "status_id / status are the merchant-visible state; payment_status the financial one; a transaction with test=true marks a sandbox payment",
    "every amount exists ex_tax / inc_tax / tax; is_tax_inclusive_pricing is the order-level flag",
    "products / shipping_addresses / coupons / fees / consignments are URL stubs on the order: captured as _products / _shipping_addresses / _coupons / _transactions",
    "customer_id 0 = guest; is_email_opt_in is an order-time checkbox WITHOUT timestamp (not a customer consent)",
    "dates are RFC 2822 with zone"
  ],
  "history": [
    {
      "at": "2026-09-21T00:00:00.000Z",
      "op": "seed",
      "from": "live:bigcommerce-test:2026-09-21",
      "origin": "reference",
      "diff": [
        "Phase 7.6: full field map from the live trial store (2 orders, one paid / completed, one incomplete with a test transaction): transactions → payments (7.2), test orders flagged"
      ]
    }
  ],
