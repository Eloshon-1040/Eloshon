      "canon": "sourceExtension.eloshon.source_url",
      "transform": "text",
      "confidence": "verified-fixture",
      "notes": "Origin page URL; kept for traceability / redirects."
    },
    {
      "path": "source_category",
      "canon": "categories",
      "transform": "category_path_split",
      "args": {
        "sep": ">",
        "listSep": "\n"
