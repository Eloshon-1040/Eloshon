      "confidence": "verified-fixture",
      "notes": "Descriptive colour (not an axis of variation)."
    },
    {
      "path": "variants",
      "canon": null,
      "transform": "ignore",
      "confidence": "verified-fixture",
      "notes": "JSON array; objects come from structure.variants (inline, parsed)."
