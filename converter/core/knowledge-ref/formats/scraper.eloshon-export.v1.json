      "path": "image_url",
      "canon": "variants[].imageSrc",
      "transform": "text",
      "when": "self",
      "confidence": "verified-fixture"
    },
    {
      "path": "price",
      "canon": "variants[].price",
      "transform": "money",
      "when": "self",
      "confidence": "verified-fixture",
      "notes": "Charged price as scraped (no promo axis in the export)."
    },
    {
      "path": "barcode",
      "canon": "variants[].barcode",
      "transform": "text",
      "when": "self",
      "confidence": "verified-fixture"
