        "variants",
        "is_alcoholic",
        "storage_info",
        "category_slug"
      ],
      "separator": ","
    }
  ],
  "structure": {
    "unit": "product",
    "variants": {
      "inlinePath": "variants",
      "parseJson": true,
      "selfWhenNone": true,
      "siblingsWhen": {
        "childPath": "code",
        "matches": "source_product_id"
      },
      "keyedBy": "source_product_id"
    },
    "options": {
      "fromVariants": {
        "name": "type",
        "value": "name"
      }
    }
  },
  "routing": {
    "platform": "eloshon",
    "entity": "products"
  },
  "fields": [
    {
      "path": "name_fr",
      "canon": "title",
      "transform": "text",
      "confidence": "verified-fixture",
      "source": "fixture:test/fixtures/scraper",
      "notes": "FR is the Scraper's primary language; EN kept when it differs (multilingual = canon-evolution-open)."
    },
    {
      "path": "name_en",
      "canon": "sourceExtension.eloshon.name_en",
      "transform": "differs_from",
      "args": {
        "other": "name_fr"
      },
      "preservationReason": "no-canon-field",
      "confidence": "verified-fixture",
      "notes": "Only when different from name_fr. Multilingual title: canon-evolution-open."
