{
  "schemaVersion": 1,
  "id": "scraper.eloshon-export.v1",
  "displayName": "Eloshon Scraper export (CSV)",
  "provenance": "scraper-generated",
  "medium": "csv",
  "platformHint": "eloshon",
  "entity": "products",
  "version": "scraper-0.4.x",
  "signatures": [
    {
      "kind": "csv-header-set",
      "required": [
        "slug_fr",
        "name_fr",
        "source_url",
        "source_product_id",
        "store_slug",
        "hs_code",
        "weight_kg",
        "image_url"
