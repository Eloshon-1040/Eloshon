    {
      "path": "slug_fr",
      "canon": "handle",
      "transform": "text",
      "confidence": "verified-fixture"
    },
    {
      "path": "slug_fr",
      "canon": "identity.slug",
      "transform": "text",
      "confidence": "verified-fixture"
    },
    {
      "path": "slug_en",
      "canon": "sourceExtension.eloshon.slug_en",
      "transform": "differs_from",
      "args": {
        "other": "slug_fr"
      },
      "preservationReason": "no-canon-field",
      "confidence": "verified-fixture"
    },
    {
      "path": "description_fr",
      "canon": "bodyHtml",
      "transform": "html",
      "confidence": "verified-fixture",
      "samplePolicy": "hash-only",
      "notes": "Plain text or HTML depending on the site; kept verbatim."
    },
    {
      "path": "description_en",
      "canon": "sourceExtension.eloshon.description_en",
      "transform": "differs_from",
