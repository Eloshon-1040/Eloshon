node_modules/
dist/
out/
*.log
.DS_Store
Thumbs.db
# bundled Chromium (large, reproducible via `npm run pw:install`)
.playwright-browsers/
# user data never lives in the repo — it goes to the OS app-data dir at runtime
data/
# generated test results (reproducible via scripts/)
scripts/site-catalogue-results/
scripts/pipeline-test-results/
# spikes (local experiments, not production code)
spikes/
# secrets
.env
.env.local
# local tooling / bundles that must never be committed. Installed skills stay
# ignored (local tools such as cloudscraper and its .venv); the project's own
# skill (eloshon-scraper-ops) and the design skills listed in
# docs/design-workflow.md are versioned so cloud sessions get the same ones.
.claude/CHANTIER .md
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/skills/*
!.claude/skills/eloshon-scraper-ops/
!.claude/skills/interface-design/
!.claude/skills/ui-ux-pro-max/
!.claude/skills/design-taste-frontend/
!.claude/skills/web-design-guidelines/
!.claude/skills/writing-guidelines/
skills-lock.json
# a local export dropped at the repo root (not a project file; the owner decides its fate)
/Nike products.json
Python-*.tar.xz
python-*-amd64.exe
# temporary local move of the extension tests (never commit)
__tests__-extension-tmp/
# admin/provider secrets never live in the repo (they go to userData/safeStorage)
dist-providers/
# extension dev signing key (PRIVATE — never commit) and packaged output
extension/.keys/
dist-extension/
# generated snapshot of shared/ (rebuilt by scripts/build-extension.mjs — never a stale committed bundle)
extension/vendor/
extension/extension-id.txt
# generated native-host manifest + launcher (machine-specific absolute paths; regenerated by host:gen)
native-host/com.eloshon.scraper.host.json
native-host/host.bat

# local AI-assistant tooling is not part of the public repository
.claude/
CLAUDE.md
